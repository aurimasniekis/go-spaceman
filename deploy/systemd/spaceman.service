# SpaceMan central. Install: site/operators/install.md (Linux only; ADR-0034).
#
#   /usr/local/bin/spaceman           binary, root-owned 0755
#   /etc/spaceman/spaceman.yaml       configuration (secret-free), root:spaceman 0640
#   /etc/spaceman/kek                 KEK, spaceman:spaceman 0400 (spaceman keys init-kek); never inside the data dir
#   /var/lib/spaceman                 data dir, spaceman:spaceman 0700 (StateDirectory)
#   git                               required on PATH (role memory, memory bundles in backups)
#
# Create the user first:  useradd --system --home-dir /var/lib/spaceman --shell /usr/sbin/nologin spaceman
# Check the sandbox on the target host with: systemd-analyze security spaceman.service

[Unit]
Description=SpaceMan control plane for persistent teams of coding agents
Documentation=https://github.com/aurimasniekis/go-spaceman/blob/main/site/operators/install.md
After=network-online.target
Wants=network-online.target
# Refuse to start when the KEK is absent (SpaceMan refuses too in production; this gives a clearer status).
AssertPathExists=/etc/spaceman/kek

[Service]
Type=simple
User=spaceman
Group=spaceman
Environment=SPACEMAN_CONFIG=/etc/spaceman/spaceman.yaml
ExecStart=/usr/local/bin/spaceman serve
# Pending database migrations run at startup after a pre-migration snapshot (site/operators/upgrade.md).
Restart=on-failure
RestartSec=5s
# SIGTERM starts the graceful shutdown (shutdown.timeout, default 30 s).
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=45s
TimeoutStartSec=120s
LimitNOFILE=65536
UMask=0077

# Data directory: created as /var/lib/spaceman, owned by User=, mode 0700. Backups default to <data_dir>/backups;
# a backups.local_dir elsewhere must be added to ReadWritePaths= below.
StateDirectory=spaceman
StateDirectoryMode=0700

# ---- Sandboxing -----------------------------------------------------------------------------------------------------
NoNewPrivileges=yes
# http.listen defaults to :8080 and needs no capabilities. Terminate TLS on 443 at a reverse proxy, or add
# CAP_NET_BIND_SERVICE to both lines below to bind a port below 1024 directly.
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/var/lib/spaceman
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @mount @swap @reboot @raw-io @module @debug @cpu-emulation @obsolete
SystemCallErrorNumber=EPERM
DevicePolicy=closed
KeyringMode=private

[Install]
WantedBy=multi-user.target
